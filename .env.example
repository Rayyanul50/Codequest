# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://codequest:codequest@localhost:5432/codequest?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Judge0 (code execution) ---
# Option A: RapidAPI hosted Judge0 CE
#   JUDGE0_URL="https://judge0-ce.p.rapidapi.com"
#   JUDGE0_API_KEY="<your rapidapi key>"
#   JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"
# Option B: self-hosted Judge0 (docker compose --profile judge0 up)
#   JUDGE0_URL="http://localhost:2358"
#   (leave JUDGE0_API_KEY empty)
#
# If JUDGE0_URL is empty the app falls back to a MOCK runner so the
# whole game loop can be demoed offline (it "passes" when your code
# is non-trivial and contains the starter function name).
JUDGE0_URL=""
JUDGE0_API_KEY=""
JUDGE0_API_HOST=""

# --- Seed admin account ---
ADMIN_EMAIL="admin@codequest.dev"
ADMIN_PASSWORD="admin12345"
